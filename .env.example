DATABASE_URL=postgresql://postgres:postgres@localhost:5432/medscope_db
API_URL=http://localhost:8000
MODEL_PATH=models/model.pkl
PORT=8000
HOST=127.0.0.1

# External data ingestion pipeline
INGESTION_API_KEY=
INGESTION_TIMEOUT_SECONDS=15
INGESTION_MAX_RETRIES=3
INGESTION_BACKOFF_FACTOR=1.5
INGESTION_LOG_LEVEL=INFO

# Scrapy crawler behaviour
INGESTION_ROBOTSTXT_OBEY=true
INGESTION_DOWNLOAD_DELAY=0.5
INGESTION_CONCURRENT_REQUESTS=1
INGESTION_CRAWL_TIMEOUT_SECONDS=300
INGESTION_SCRAPY_LOG_LEVEL=INFO
